(version 1)

# The CC1101 decoupling / bias parts sit tight against the QFN, as in TI's
# reference layouts: their pads and bodies clear the package (>= 0.1 mm), only
# the 0.25 mm courtyard margins touch. Allow that for these parts only.
(rule "CC1101 decoupling tucked against the QFN"
  (condition "A.Reference == 'U1' || A.Reference == 'U501' || B.Reference == 'U1' || B.Reference == 'U501'")
  (constraint courtyard_clearance (min -0.3mm)))
